<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<StackPane prefHeight="150.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="story_game.gui.window.MainMenuWindow">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Super Cool Game" textAlignment="CENTER" underline="true" wrappingWidth="291.6949462890625">
               <font>
                  <Font name="Segoe Script Bold" size="34.0" />
               </font>
            </Text>
            <Button id="newGame" contentDisplay="CENTER" mnemonicParsing="false" onMouseClicked="#newGame" text="New game" />
            <Button mnemonicParsing="false" onAction="#loadGame" text="Load game" />
            <Button mnemonicParsing="false" onAction="#achievements" text="Achievements" />
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#options" text="Options" />
            <Button mnemonicParsing="false" onAction="#exit" text="Exit" />
         </children>
      </VBox>
   </children>
</StackPane>
